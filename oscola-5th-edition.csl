<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="en-GB" page-range-format="expanded" demote-non-dropping-particle="never">
  <info>
    <title>OSCOLA 5th edition (EU, international and academic sources)</title>
    <title-short>OSCOLA 5</title-short>
    <id>http://www.zotero.org/styles/oscola-5th-edition-eu-international</id>
    <link href="http://www.zotero.org/styles/oscola-5th-edition-eu-international" rel="self"/>
    <link href="https://www.law.ox.ac.uk/oscola" rel="documentation"/>
    <category citation-format="note"/>
    <category field="law"/>
    <summary>Unofficial implementation of the Oxford University Standard for Citation of Legal Authorities, 5th edition (2026), with emphasis on EU legislation and case law, international treaties and tribunals, and secondary/academic sources. Implements the 5th edition removal of 'ibid', ECLI-based CJEU citation, italicised thesis titles, and DOI/persistent-link handling.</summary>
    <updated>2026-08-16T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="et-al">and others</term>
      <term name="and">and</term>
      <term name="accessed">accessed</term>
      <term name="no date">nd</term>
      <term name="edition" form="short">edn</term>
      <term name="editor" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
      <term name="translator" form="short">tr</term>
      <term name="editortranslator" form="short">
        <single>ed and tr</single>
        <multiple>eds and trs</multiple>
      </term>
      <term name="paragraph" form="short">
        <single>para</single>
        <multiple>paras</multiple>
      </term>
      <term name="section" form="short">
        <single>s</single>
        <multiple>ss</multiple>
      </term>
      <term name="chapter" form="short">
        <single>ch</single>
        <multiple>chs</multiple>
      </term>
      <term name="part" form="short">
        <single>pt</single>
        <multiple>pts</multiple>
      </term>
      <term name="rule" form="short">
        <single>r</single>
        <multiple>rr</multiple>
      </term>
      <term name="open-quote">‘</term>
      <term name="close-quote">’</term>
      <term name="open-inner-quote">“</term>
      <term name="close-inner-quote">”</term>
    </terms>
  </locale>

  <!-- ============ NAMES ============ -->

  <macro name="author-note">
    <choose>
      <if variable="author">
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="1"/>
          <et-al term="et-al"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="1"/>
          <et-al term="et-al"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="author-bib">
    <choose>
      <if variable="author">
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" name-as-sort-order="all" sort-separator=" " initialize-with="" et-al-min="4" et-al-use-first="1"/>
          <et-al term="et-al"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" name-as-sort-order="all" sort-separator=" " initialize-with="" et-al-min="4" et-al-use-first="1"/>
          <et-al term="et-al"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="author-subsequent">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="1"/>
          <et-al term="et-al"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="1"/>
          <et-al term="et-al"/>
        </names>
      </else-if>
      <else>
        <text macro="short-form"/>
      </else>
    </choose>
  </macro>

  <macro name="secondary-contributors">
    <group delimiter=", ">
      <names variable="translator">
        <name and="text" delimiter=", " delimiter-precedes-last="never"/>
        <label form="short" prefix=" "/>
      </names>
      <choose>
        <if variable="author">
          <names variable="editor">
            <name and="text" delimiter=", " delimiter-precedes-last="never"/>
            <label form="short" prefix=" "/>
          </names>
        </if>
      </choose>
    </group>
  </macro>

  <!-- ============ TITLES ============ -->

  <macro name="title-main">
    <choose>
      <if type="book thesis report motion_picture manuscript graphic legal_case" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else-if type="legislation treaty bill standard document" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <macro name="short-form">
    <choose>
      <if variable="title-short">
        <choose>
          <if type="legislation treaty bill" match="any">
            <text variable="title-short"/>
          </if>
          <else>
            <text variable="title-short" font-style="italic"/>
          </else>
        </choose>
      </if>
      <else>
        <text macro="title-main"/>
      </else>
    </choose>
  </macro>

  <macro name="short-title-parenthetical">
    <choose>
      <if variable="title-short">
        <text variable="title-short" prefix=" (‘" suffix="’)"/>
      </if>
    </choose>
  </macro>

  <!-- ============ DATES ============ -->

  <macro name="year-only">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date-full">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date-entry-into-force">
    <date variable="original-date">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="accessed-date">
    <date variable="accessed">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <!-- ============ PRIMARY SOURCES ============ -->

  <!-- EU legislation, EU treaties, and domestic statutes.
       Domestic statute: leave the Code field empty (year sits inside the title).
       EU material: Code = "OJ", Code Number = "L192" or "C202", Pages = first page. -->
  <macro name="legislation-cite">
    <group delimiter=" ">
      <text macro="title-main"/>
      <choose>
        <if variable="container-title">
          <group delimiter=" ">
            <text macro="year-only" prefix="[" suffix="]"/>
            <group>
              <group delimiter=" ">
                <text variable="container-title"/>
                <text variable="volume"/>
              </group>
              <text variable="page" prefix="/"/>
            </group>
          </group>
        </if>
      </choose>
    </group>
    <text macro="short-title-parenthetical"/>
  </macro>

  <!-- International treaties:
       Title | (adopted DATE, entered into force ORIGINAL-DATE) | VOL SERIES PAGE -->
  <macro name="treaty-cite">
    <group delimiter=" ">
      <text macro="title-main"/>
      <group prefix="(" suffix=")" delimiter=", ">
        <text macro="date-full" prefix="adopted "/>
        <text macro="date-entry-into-force" prefix="entered into force "/>
      </group>
      <group delimiter=" ">
        <text variable="volume"/>
        <text variable="container-title"/>
        <text variable="page"/>
      </group>
      <text variable="references"/>
    </group>
    <text macro="short-title-parenthetical"/>
  </macro>

  <!-- Cases: CJEU/General Court, ECtHR, ICJ, ICC, arbitral tribunals, domestic courts.
       Docket Number  -> printed BEFORE the case name (e.g. "Case C-403/03")
       Court          -> printed after the case name (e.g. "ECtHR")
       Volume/Reporter/First Page -> report or ECLI information
       Date Decided   -> printed in brackets; leave EMPTY for CJEU and for
                         report-cited cases where the year already appears. -->
  <macro name="case-cite">
    <group delimiter=" ">
      <text variable="number"/>
      <text macro="title-main"/>
      <text variable="genre"/>
      <text variable="authority"/>
      <group delimiter=" ">
        <text variable="volume"/>
        <text variable="container-title"/>
        <text variable="page"/>
      </group>
      <choose>
        <if variable="issued">
          <text macro="date-full" prefix="(" suffix=")"/>
        </if>
      </choose>
      <text variable="references"/>
    </group>
    <text macro="short-title-parenthetical"/>
  </macro>

  <!-- ============ SECONDARY SOURCES ============ -->

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher-year">
    <group delimiter=" ">
      <text variable="publisher"/>
      <text macro="year-only"/>
    </group>
  </macro>

  <macro name="journal-name">
    <choose>
      <if variable="container-title-short">
        <text variable="container-title-short"/>
      </if>
      <else>
        <text variable="container-title"/>
      </else>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: "/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="&lt;" suffix="&gt;"/>
          <choose>
            <if variable="accessed">
              <group delimiter=" ">
                <text term="accessed"/>
                <text macro="accessed-date"/>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="secondary-cite">
    <choose>

      <!-- Journal articles and book reviews -->
      <if type="article-journal review review-book" match="any">
        <group delimiter=" ">
          <group delimiter=" ">
            <choose>
              <if variable="volume">
                <text macro="year-only" prefix="(" suffix=")"/>
                <text variable="volume"/>
              </if>
              <else>
                <text macro="year-only" prefix="[" suffix="]"/>
              </else>
            </choose>
            <text macro="journal-name"/>
            <text variable="page-first"/>
          </group>
          <text macro="access"/>
          <text variable="genre" prefix="(" suffix=")"/>
        </group>
      </if>

      <!-- Chapters in edited collections -->
      <else-if type="chapter entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=" ">
          <group delimiter=", ">
            <names variable="editor" prefix="in ">
              <name and="text" delimiter=", " delimiter-precedes-last="never"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text variable="container-title" font-style="italic"/>
          </group>
          <group prefix="(" suffix=")" delimiter=", ">
            <names variable="translator">
              <name and="text" delimiter=", " delimiter-precedes-last="never"/>
              <label form="short" prefix=" "/>
            </names>
            <text macro="edition"/>
            <text macro="publisher-year"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Books -->
      <else-if type="book" match="any">
        <group delimiter=" ">
          <group prefix="(" suffix=")" delimiter=", ">
            <text macro="secondary-contributors"/>
            <text macro="edition"/>
            <text macro="publisher-year"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Theses (5th edn: titles are italicised, not in inverted commas) -->
      <else-if type="thesis" match="any">
        <group delimiter=" ">
          <group prefix="(" suffix=")" delimiter=", ">
            <text variable="genre"/>
            <text macro="publisher-year"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Reports and command papers -->
      <else-if type="report" match="any">
        <group delimiter=" ">
          <choose>
            <if variable="number">
              <group prefix="(" suffix=")" delimiter=", ">
                <text variable="number"/>
                <text macro="year-only"/>
              </group>
            </if>
            <else>
              <text macro="publisher-year" prefix="(" suffix=")"/>
            </else>
          </choose>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Newspaper articles (5th edn: no city of publication) -->
      <else-if type="article-newspaper article-magazine" match="any">
        <group delimiter=" ">
          <text variable="container-title" font-style="italic"/>
          <text macro="date-full" prefix="(" suffix=")"/>
          <text variable="page-first"/>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Lectures and speeches -->
      <else-if type="speech" match="any">
        <group delimiter=" ">
          <group prefix="(" suffix=")" delimiter=", ">
            <text variable="genre"/>
            <text variable="event-place"/>
            <text macro="date-full"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Websites, blogs, social media -->
      <else-if type="webpage post-weblog post" match="any">
        <group delimiter=" ">
          <group prefix="(" suffix=")" delimiter=", ">
            <text variable="container-title"/>
            <text macro="date-full"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>

      <!-- Generic documents, generative AI output, miscellaneous -->
      <else>
        <group delimiter=" ">
          <text variable="genre"/>
          <text macro="date-full" prefix="(" suffix=")"/>
          <text macro="access"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="document-publisher">
    <choose>
      <if type="document manuscript" match="any">
        <text variable="publisher"/>
      </if>
    </choose>
  </macro>

  <!-- ============ PINPOINTS ============ -->

  <macro name="pinpoint">
    <choose>
      <if type="legal_case" match="any">
        <choose>
          <if locator="paragraph">
            <text variable="locator" prefix=" [" suffix="]"/>
          </if>
          <else-if locator="page">
            <text variable="locator" prefix=", "/>
          </else-if>
          <else>
            <group prefix=", " delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </if>
      <else-if type="legislation treaty bill" match="any">
        <choose>
          <if locator="page">
            <text variable="locator" prefix=", "/>
          </if>
          <else>
            <group prefix=", " delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </else-if>
      <else>
        <choose>
          <if locator="page">
            <text variable="locator" prefix=", "/>
          </if>
          <else>
            <group prefix=" " delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </else>
    </choose>
  </macro>

  <macro name="pinpoint-subsequent">
    <choose>
      <if type="legal_case" match="any">
        <choose>
          <if locator="paragraph">
            <text variable="locator" prefix=" [" suffix="]"/>
          </if>
          <else-if locator="page">
            <text variable="locator" prefix=" "/>
          </else-if>
          <else>
            <group prefix=" " delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </if>
      <else>
        <choose>
          <if locator="page">
            <text variable="locator" prefix=" "/>
          </if>
          <else>
            <group prefix=" " delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </else>
    </choose>
  </macro>

  <!-- ============ CITATION ============ -->

  <citation>
    <layout suffix="." delimiter="; ">
      <choose>

        <!-- Subsequent citations: OSCOLA 5 abolishes 'ibid'. -->
        <if position="subsequent">
          <choose>
            <!-- Legislation and treaties: short form, no cross-citation. -->
            <if type="legislation treaty bill" match="any">
              <text macro="short-form"/>
              <text macro="pinpoint"/>
            </if>
            <else>
              <group delimiter=" ">
                <text macro="author-subsequent"/>
                <text variable="first-reference-note-number" prefix="(n " suffix=")"/>
              </group>
              <text macro="pinpoint-subsequent"/>
            </else>
          </choose>
        </if>

        <!-- First citations -->
        <else-if type="legislation" match="any">
          <text macro="legislation-cite"/>
          <text macro="pinpoint"/>
        </else-if>

        <else-if type="treaty" match="any">
          <text macro="treaty-cite"/>
          <text macro="pinpoint"/>
        </else-if>

        <else-if type="legal_case" match="any">
          <text macro="case-cite"/>
          <text macro="pinpoint"/>
        </else-if>

        <else-if type="bill hearing" match="any">
          <group delimiter=" ">
            <text macro="title-main"/>
            <text variable="authority"/>
            <text macro="year-only"/>
          </group>
          <text macro="pinpoint"/>
        </else-if>

        <else>
          <group delimiter=", ">
            <text macro="author-note"/>
            <text macro="title-main"/>
            <text macro="document-publisher"/>
          </group>
          <text macro="secondary-cite" prefix=" "/>
          <text macro="pinpoint"/>
        </else>
      </choose>
    </layout>
  </citation>

  <!-- ============ BIBLIOGRAPHY ============ -->

  <bibliography hanging-indent="false" entry-spacing="0" subsequent-author-substitute="——" subsequent-author-substitute-rule="complete-all">
    <sort>
      <key macro="author-bib"/>
      <key macro="title-main"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <choose>
        <if type="legislation" match="any">
          <text macro="legislation-cite"/>
        </if>
        <else-if type="treaty" match="any">
          <text macro="treaty-cite"/>
        </else-if>
        <else-if type="legal_case" match="any">
          <text macro="case-cite"/>
        </else-if>
        <else-if type="bill hearing" match="any">
          <group delimiter=" ">
            <text macro="title-main"/>
            <text variable="authority"/>
            <text macro="year-only"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text macro="author-bib"/>
            <text macro="title-main"/>
            <text macro="document-publisher"/>
          </group>
          <text macro="secondary-cite" prefix=" "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
